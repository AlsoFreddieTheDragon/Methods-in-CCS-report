---
API: 3
OpenSesame: 4.1.9
Platform: nt
---
set width 1280
set uniform_coordinates yes
set title Algebra
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend legacy
set round_decimals 2
set mouse_backend xpyriment
set keyboard_backend legacy
set height 1024
set fullscreen no
set form_clicks no
set foreground white
set font_underline no
set font_size 24
set font_italic no
set font_family sans
set font_bold no
set experiment_path "C:\\Users\\ruthv\\Downloads"
set disable_garbage_collection yes
set description "Algebra for fMRI & EEG"
set coordinates uniform
set compensation 0
set color_backend legacy
set clock_backend legacy
set canvas_backend xpyriment
set bidi yes
set background black

define form_text_input Answer
	set timeout "[solve_time]"
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var participant_response
	set form_title "Answer:"
	set form_question ""
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define sketchpad Welcome
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=24 html=yes show_if=True text="Welcome to the Multiplication Game!<br /><br />Thank you for taking part in this experiment.<br />Get ready to put your mental math skills to the test!<br />Press any key to continue." x=0 y=0 z_index=0

define sequence adaptive_trial_block
	set flush_keyboard yes
	set description "Runs four trials followed by adaptation"
	run trial_loop_experiment always
	run online_adaptation_script always

define sketchpad black
	set duration 200
	set description "Displays stimuli"

define sketchpad black2_1
	set duration 1
	set description "Displays stimuli"

define sequence block_sequence
	set flush_keyboard yes
	set description "A sequence containing a single block of trials followed by feedback to the participant"
	run block_stuff always
	run sub_block_loop True
	run var_break_time True
	run end_of_block always
	run confusion always
	run black always

define sequence block_sequence_practice
	set flush_keyboard yes
	set description "A sequence containing a single block of trials followed by feedback to the participant"
	run trial_loop_practice always

define inline_script block_stuff
	set description "Executes Python code"
	set _run ""
	set _prepare "var.block = var.block + 1"

define inline_script calculate_callibration
	set description "Calculates calibration baseline"
	___run__
	if var.callibration == 'yes':
	    print("Calibration trial:", var.trial)
	    if var.answered_correct == 1:
	        callibration_list.append(var.answer_time)
	    if var.trial == 10:
	        print("Calibration times:", callibration_list)
	        if len(callibration_list) >= 7:
	            var.median_time = float(np.median(callibration_list))
	            var.callibration_order = sorted(callibration_list, reverse=True)
	            var.callibrated_time = float(np.percentile(callibration_order, 75))
	        else:
	            var.callibrated_time = 10000.0
	        print("Calibration baseline:", var.callibrated_time)
	__end__
	set _prepare ""

define loop callibration_loop
	set source table
	set repeat 10
	set order random
	set description "Calibration trials"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if False
	setcycle 0 confusion_type 0
	setcycle 0 callibration yes
	run trial_sequence

define inline_script confusion
	set description "Executes Python code"
	set _run "my_mouse.flush()"
	___prepare__
	def create_confusion_screen(con_type):
	
	    con_screen_text = "you should not see this"
	
	    if con_type == 1:
	
	        con_screen_text = incorrect_close()
	
	    elif con_type == 2:
	
	        con_screen_text = incorrect_far()
	
	    elif con_type == 3:
	
	        con_screen_text = var.correct_response
	
	    else:
	
	        con_screen_text = ""
	
	    return con_screen_text
	
	
	def incorrect_close():
	
	    con_screen_text = df.iloc[problem_index]["incorrect_but_close"]
	
	    return con_screen_text
	
	
	def incorrect_far():
	
	    con_screen_text = df.iloc[problem_index]["incorrect_unrelated"]
	
	    return con_screen_text
	
	
	con_screen_text = "something went wrong"
	
	con_screen_text = create_confusion_screen(var.confusion_type)
	
	var.con_screen = con_screen_text
	__end__

define sketchpad confusion_screen
	set duration "[con_dur]"
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=24 html=yes show_if=True text="[con_screen]" x=0 y=0 z_index=0

define inline_script create_problem
	set description "Executes Python code"
	set _run "my_mouse.flush()"
	___prepare__
	var.trial = var.trial + 1
	
	max_index = len(df)-1
	problem_index = random.randrange(max_index)
	
	row = df.iloc[problem_index]
	
	var.cur_problem = row["problem"]
	var.correct_response = row["two_digit"] * row["one_digit"]
	
	var.problem_two_digits = row["two_digit"]
	var.problem_one_digit = row["one_digit"]
	
	var.fix_dur = 500
	__end__

define sketchpad end_calibration
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=24 html=yes show_if=True text="2nd Phase: Practice<br /><br />Great job completing the Calibration Phase!<br /><br />Now you will have 4 trials to familiarize yourself<br />with the setting of the actual experiment.<br /><br />This is your chance to get comfortable, no pressure at all!<br /><br />Press any key to start the Practice Phase." x=0 y=0 z_index=0

define sketchpad end_of_block
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=28 html=yes show_if=always text="This is the end of block [block] of 4. <br />[time_break] <br />Press any key to continue<br />" x=0 y=32 z_index=0

define sketchpad end_of_experiment
	set start_response_interval no
	set duration keypress
	set description "A sketchpad notifying the participant that the experiment is finished"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=34 html=yes show_if=True text="This is the END!<br /><br />You have successfully completed all 4 blocks.<br />Thank you so much for your participation!" x=0.0 y=96.0 z_index=0

define sketchpad end_of_practice
	set start_response_interval no
	set duration keypress
	set description "A sketchpad notifying the participant that the practice phase is finished"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=24 html=yes show_if=True text="Experiment Phase:<br />3rd Phase: Experiment<br /><br />You're all set! You've got the hang of it now.<br /><br />The experiment consists of 4 blocks of 20 multiplications each.<br />After introducing the answer press ENTER!!<br />In between blocks you will have breaks to rest.<br /><br /><br />Remember: solve correctly and as fast as you can!<br />If you don't answer within this time, the answer will be counted as incorrect.<br /><br />Press any key to continue<br />" x=0 y=0 z_index=0

define sequence experiment
	set flush_keyboard yes
	set description "The main sequence of the experiment"
	run preparation always
	run init_vars always
	run Welcome True
	run instructions always
	run start_calibration always
	run black always
	run callibration_loop True
	run end_calibration True
	run initialize_adaptation True
	run practice_loop always
	run end_of_practice always
	run start_of_exp always
	run black always
	run start_experiment_adaptation True
	run experimental_loop always
	run end_of_experiment always

define loop experimental_loop
	set source_file ""
	set source table
	set skip 0
	set repeat 1
	set order sequential
	set offset no
	set item block_sequence
	set description "A loop containing one or more experimental blocks"
	set cycles 4
	set continuous no
	set column_order practice
	set break_if_on_first yes
	set break_if never
	setcycle 0 practice no
	setcycle 1 practice no
	setcycle 2 practice no
	setcycle 3 practice no
	run block_sequence

define sketchpad fixation
	set start_response_interval no
	set duration "[fix_dur]"
	set description "Displays stimuli"
	draw fixdot color=white show_if=always style=default x=0 y=0 z_index=0

define sketchpad fixation_end
	set duration 995
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=38 html=yes show_if=always text="+" x=0 y=0 z_index=0

define inline_script init_vars
	set description "Executes Python code"
	___run__
	var.window_time = 10000
	var.solve_time = var.window_time
	var.problem_dur = 2000
	var.con_dur = 500
	__end__
	set _prepare ""

define inline_script initialize_adaptation
	set description "Initializes adaptive answer time"
	___run__
	adaptive.initialize(var.median_time)
	
	var.solve_time = adaptive.get_current_time()
	var.callibration = 'no'
	
	print("Adaptive timing initialized:", var.solve_time)
	__end__
	set _prepare ""

define sketchpad instructions
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=28 html=yes show_if=True text="Explaining the experiment:<br />For this experiment you have to solve two-digit by 1 digit multiplications<br />which will be separated by some time.<br />Example: 12 x 8<br /><br />What does this experiment consist of?<br />1- A window will appear with the equation, example: 12 x 8<br />2- Then wait for the response prompt to appear<br />3- Type in the numerical answer to the multiplication when prompted <br />and after press ENTER<br /><br />Goal: You need to solve the multiplication correctly<br />while being as fast as possible.<br /><br />This experiment consists of 3 phases: Calibration, Practice and Experiment.<br />Let's go through each one!<br />Press any key to continue." x=0 y=0 z_index=0

