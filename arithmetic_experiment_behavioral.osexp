define inline_script online_adaptation_script
	set description "Executes Python code"
	___run__
	adaptive.adapt()
	var.solve_time = adaptive.get_current_time()
	var.adaptive_accuracy = adaptive.get_recent_accuracy()
	__end__
	set _prepare ""

define loop practice_loop
	set source_file ""
	set source table
	set skip 0
	set repeat 1
	set order random
	set offset no
	set item block_sequence_practice
	set description "A loop containing one or more practice blocks"
	set cycles 1
	set continuous no
	set column_order practice
	set break_if_on_first yes
	set break_if never
	setcycle 0 practice yes
	run block_sequence_practice

define inline_script preparation
	set description "Executes Python code"
	___run__
	my_mouse.flush()
	#keypad_canvas.show()
	#print 'hallo'
	__end__
	___prepare__
	import random
	import pandas as pd
	import numpy as np
	import time
	var.block = 0
	var.trial = 0
	callibration_list = []
	#prepare mouse
	my_mouse = mouse()
	#prepare keypad canvas
	keypad_canvas = canvas()
	keypad_canvas.penwidth = 2
	keypad_canvas.font_size = 24
	# draw keys
	#keys_xy = xy_grid(3, 48)
	keys_xy = xy_circle(9,70,-85)
	keys_val = [1,2,3,4,5,6,7,8,9]
	button_size = 42
	displacement = button_size/2
	min_x = min(keys_xy)[0] - displacement
	max_x = max(keys_xy)[0] + displacement
	min_y = min(keys_xy)[1] - displacement
	max_y = max(keys_xy)[1] + displacement
	i = 0
	for x, y in keys_xy:
	    #keypad_canvas.rect(x-displacement, y-displacement, button_size, button_size, fill=True, color='lightslategrey')
	    #keypad_canvas.rect(x-displacement, y-displacement, button_size, button_size, color='darkgrey')
	    keypad_canvas.circle(x,y,button_size/2,fill=True,color='lightslategrey')
	    keypad_canvas.circle(x,y,button_size/2,color='darkgrey')
	    #digit
	    keypad_canvas.text(keys_val[i],x=x,y=y)
	    i=i+1
	# 1) Read the Excel file
	# margot path
	df = pd.read_excel('C:/Users/ruthv/Downloads/multiplications_filled.xlsx')
	#df = pd.read_excel('C:/Users/Jaylee van Ligten/Downloads/multiplications_filled.xlsx')
	# 2) Dataframe already holds all columns with the same names as in the Excel file:
	# problem, two_digit, one_digit, correct_answer, incorrect_but_close, incorrect_unrelated
	# 3) Save each column as its own variable
	problems = df['problem']
	two_digit = df['two_digit']
	one_digit = df['one_digit']
	correct_answer = df['correct_answer']
	incorrect_but_close = df['incorrect_but_close']
	incorrect_unrelated = df['incorrect_unrelated']
	class AdaptiveAnswerTime:
	    def __init__(
	        self,
	        calibration_trials=10,
	        min_correct_required=7,
	        lower_threshold=0.70,
	        upper_threshold=0.90,
	        target_accuracy=0.80,
	        max_step=200,
	        min_fraction=0.40,
	        absolute_floor=800,
	        max_time_buffer=3000,
	        window_size=12
	    ):
	        self.calibration_trials = calibration_trials
	        self.min_correct_required = min_correct_required
	        self.calibration_times = []
	        self.calibration_correct = []
	        self.lower_threshold = lower_threshold
	        self.upper_threshold = upper_threshold
	        self.target_accuracy = target_accuracy
	        self.max_step = max_step
	        self.min_fraction = min_fraction
	        self.absolute_floor = absolute_floor
	        self.max_time_buffer = max_time_buffer
	        self.window_size = window_size
	        self.accuracy_history = []
	        self.current_time = None
	        self.min_time = None
	        self.max_time = None
	        self.calibration_reliable = None
	    def record_calibration_trial(self, solving_time, correct):
	        if (
	            solving_time is not None
	            and len(self.calibration_times) < self.calibration_trials
	        ):
	            self.calibration_times.append(solving_time)
	            self.calibration_correct.append(bool(correct))
	    def finish_calibration(self):
	        if len(self.calibration_times) < self.calibration_trials:
	            raise ValueError(
	                f"Expected {self.calibration_trials} "
	                f"calibration trials, but only received "
	                f"{len(self.calibration_times)}."
	            )
	        correct_times = [
	            time
	            for time, correct in zip(
	                self.calibration_times,
	                self.calibration_correct
	            )
	            if correct
	        ]
	        if len(correct_times) < self.min_correct_required:
	            self.calibration_reliable = False
	            median_time = 10000.0
	        else:
	            self.calibration_reliable = True
	            median_time = float(np.median(correct_times))
	        self.max_time = median_time + self.max_time_buffer
	        self.min_time = max(
	            self.absolute_floor,
	            median_time * self.min_fraction
	        )
	        self.current_time = float(
	            np.clip(
	                median_time,
	                self.min_time,
	                self.max_time
	            )
	        )
	        return self.current_time
	    def initialize(self, baseline):
	        self.max_time = baseline + self.max_time_buffer
	        self.min_time = max(
	            self.absolute_floor,
	            baseline * self.min_fraction
	        )
	        self.current_time = float(
	            np.clip(
	                baseline,
	                self.min_time,
	                self.max_time
	            )
	        )
	        return self.current_time
	    def record_trial(self, correct):
	        if correct is None:
	            return
	        if isinstance(correct, (float, np.floating)):
	            if np.isnan(correct):
	                return
	        self.accuracy_history.append(bool(correct))
	    def adapt(self):
	        if self.current_time is None:
	            raise ValueError(
	                "Calibration should first be completed "
	                "before adaptation."
	            )
	        if len(self.accuracy_history) < self.window_size:
	            return self.current_time
	        recent_trials = self.accuracy_history[-self.window_size:]
	        accuracy = np.mean(recent_trials)
	        if accuracy < self.lower_threshold:
	            difference = self.lower_threshold - accuracy
	            adjustment = (
	                difference / 0.05
	            ) * self.max_step
	            adjustment = float(
	                np.clip(
	                    adjustment,
	                    0,
	                    self.max_step
	                )
	            )
	            self.current_time += adjustment
	        elif accuracy > self.upper_threshold:
	            difference = accuracy - self.upper_threshold
	            adjustment = (
	                difference / 0.05
	            ) * self.max_step
	            adjustment = float(
	                np.clip(
	                    adjustment,
	                    0,
	                    self.max_step
	                )
	            )
	            self.current_time -= adjustment
	        self.current_time = float(
	            np.clip(
	                self.current_time,
	                self.min_time,
	                self.max_time
	            )
	        )
	        return self.current_time
	    def get_current_time(self):
	        return self.current_time
	    def get_recent_accuracy(self):
	        if len(self.accuracy_history) < self.window_size:
	            return None
	        recent_trials = self.accuracy_history[-self.window_size:]
	        return np.mean(recent_trials)
	adaptive = AdaptiveAnswerTime()
	var.experiment_phase = 'calibration'
	__end__

define sketchpad problem
	set timeout "[problem_dur]"
	set duration "[problem_dur]"
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=28 html=yes show_if=always text="[cur_problem]" x=0 y=0 z_index=0

define inline_script record_accuracy
	set description "Records trial accuracy for adaptive timing"
	___run__
	if var.experiment_phase == 'experiment':
	    adaptive.record_trial(var.correct)
	__end__
	set _prepare ""

define inline_script response_evaluation
	set description "Executes Python code"
	___run__
	# # #log RTs and response
	#var.RT_problem = var.response_time_problem
	#var.RT_response = mouse_time - var.time_keypad
	var.response = participant_response
	# Calculate how long participant took to answer
	var.answer_time = (time.perf_counter() - var.start_time) * 1000
	var.answered_correct = 0
	var.correct = 0
	# Convert typed response to a number
	try:
	    response_value = int(participant_response)
	except (TypeError, ValueError):
	    response_value = None
	if response_value == int(var.correct_response):
	    var.answered_correct = 1
	    var.correct = 1
	    print("correctomundo")
	else:
	    var.correct = 0
	    print("bad, very bad")
	df = df.drop(df.index[problem_index])
	print("ARE WE DELETING THIS STUFF??????", df.shape)
	problems = df['problem']
	two_digit = df['two_digit']
	one_digit = df['one_digit']
	correct_answer = df['correct_answer']
	incorrect_but_close = df['incorrect_but_close']
	incorrect_unrelated = df['incorrect_unrelated']
	__end__
	set _prepare ""

define sketchpad start_calibration
	set start_response_interval no
	set duration keypress
	set description "A sketchpad containing the instructions for the participant"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=24 html=yes show_if=True text="Calibration Phase:<br />1st Phase: Calibration<br /><br />You will need to solve 10 multiplications, one by one,<br />without any extra stimulus.<br /><br />After introducing the answer press ENTER<br /><br />This helps us set the right amount of time for you<br />to solve the equations in the Experiment Phase.<br /><br />Take your time and do your best, you're doing great!<br /><br />Press any key to start the Calibration Phase." x=0 y=0 z_index=0

define inline_script start_experiment_adaptation
	set description "Starts experimental adaptation"
	___run__
	var.experiment_phase = 'experiment'
	print("Experimental adaptation started")
	print("Initial solve time:", adaptive.get_current_time())
	__end__
