	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=24 html=yes show_if=True text="The experiment will start now. Good luck!<br /><br />Press any key to start the experiment." x=0 y=0 z_index=0

define inline_script start_timer
	set description "Executes Python code"
	set _run "var.start_time = time.perf_counter()"
	set _prepare ""

define loop sub_block_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Repeatedly runs another item"
	set cycles 5
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 sub_block 1
	setcycle 1 sub_block 2
	setcycle 2 sub_block 3
	setcycle 3 sub_block 4
	setcycle 4 sub_block 5
	run adaptive_trial_block

define loop trial_loop_experiment
	set source_file ""
	set source table
	set skip 0
	set repeat 1
	set order random
	set offset no
	set item trial_sequence
	set description "A single block of trials"
	set cycles 4
	set continuous no
	set column_order "problem_type;Retrieval;Transformation"
	set break_if_on_first yes
	set break_if False
	setcycle 0 confusion_type 0
	setcycle 1 confusion_type 1
	setcycle 2 confusion_type 2
	setcycle 3 confusion_type 3
	run trial_sequence

define loop trial_loop_practice
	set source_file ""
	set source table
	set skip 0
	set repeat 1
	set order random
	set offset no
	set item trial_sequence
	set description "A single block of trials"
	set cycles 4
	set continuous no
	set column_order "problem_type;Retrieval;Transformation"
	set break_if_on_first yes
	set break_if False
	setcycle 0 confusion_type 0
	setcycle 1 confusion_type 1
	setcycle 2 confusion_type 2
	setcycle 3 confusion_type 3
	run trial_sequence

define sequence trial_sequence
	set flush_keyboard yes
	set description "A single trial"
	run create_problem always
	run fixation always
	run confusion always
	run problem always
	run confusion_screen True
	run start_timer True
	run Answer True
	run response_evaluation True
	run calculate_callibration True
	run keypad_response always
	run record_accuracy always
	run black2_1 always
	run fixation_end always
	run logger always

define inline_script var_break_time
	set description "Ejecuta código en Python"
	set _run ""
	___prepare__
	if block < 4:
	    time_break = "You can take a short break."
	else:
	    time_break = "Well done!"
	__end__

